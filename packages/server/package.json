{
  "name": "@metroclavier/server",
  "version": "0.1.0",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.6",
    "@metroclavier/shared": "workspace:*"
  },
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "generate-playable-trips": "bun scripts/generate-playable-trips.ts",
    "import-gtfs": "bun scripts/import-gtfs.ts"
  },
  "type": "module",
  "main": "src/index.ts"
}
